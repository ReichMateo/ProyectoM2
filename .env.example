# Configuración para desarrollo local o producción

# URL de conexión a PostgreSQL
# Formato: postgresql://usuario:contraseña@host:puerto/base_datos
# Desarrollo local: postgresql://postgres:password@localhost:5432/miniblog
# Railway: Se configura automáticamente desde el plugin PostgreSQL
DATABASE_URL=postgresql://user:password@localhost:5432/miniblog

# Puerto del servidor Express
PORT=4000
